# Source only in a clean Noetic shell; never edit the manufacturer's .bashrc.
if [ -n "${ROS_DISTRO:-}" ] && [ "$ROS_DISTRO" != noetic ]; then
  echo "This shell contains $ROS_DISTRO. Run bash ~/Rob2Nav/deployment/go2edu/open_noetic.sh" >&2
  return 1
fi
export NAV_ROOT="$HOME/go2edu_nav"
export ROB2NAV_ROOT="$HOME/Rob2Nav"
source /opt/ros/noetic/setup.bash
for setup in "$NAV_ROOT/ws_livox/devel/setup.bash" "$NAV_ROOT/ws_lio/devel/setup.bash" "$NAV_ROOT/SCAN-Planner/devel/setup.bash"; do
  if [ -f "$setup" ]; then source "$setup"; fi
done
export ROS_MASTER_URI=http://127.0.0.1:11311
export ROS_IP=127.0.0.1
export CYCLONEDDS_HOME="$NAV_ROOT/cyclonedds/install"
export LD_LIBRARY_PATH="$CYCLONEDDS_HOME/lib:${LD_LIBRARY_PATH:-}"
cd "$ROB2NAV_ROOT"
