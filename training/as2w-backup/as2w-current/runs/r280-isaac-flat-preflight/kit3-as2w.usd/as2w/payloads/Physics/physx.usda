#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "AS2W"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "AS2W"
{
    over "Physics"
    {
        over "FL_hip" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

