#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "AS2W"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "AS2W" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "FL_hip" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FR_hip" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RL_hip" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RR_hip" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FL_thigh" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FL_calf" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FL_foot" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FR_thigh" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FR_calf" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "FR_foot" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RL_thigh" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RL_calf" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RL_foot" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RR_thigh" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RR_calf" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "RR_foot" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "FL_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "FL_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "FL_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "FL_foot" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "FR_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "FR_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "FR_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "FR_foot" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "RL_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RL_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "RL_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "RL_foot" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "RR_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RR_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "RR_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "RR_foot" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

